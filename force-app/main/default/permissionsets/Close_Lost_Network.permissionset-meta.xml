<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Close Lost Network</label>
    <description>Grants access to the Close Lost Opportunity network process (fields, flow).</description>
    <classAccesses>
        <apexClass>ChildAccountSelectorController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>OPP_Close_lost_opp_put_child_accounts_in_Nurturing_stage</flow>
    </flowAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Lifecycle_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Nurturing_Stage_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.Loss_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
